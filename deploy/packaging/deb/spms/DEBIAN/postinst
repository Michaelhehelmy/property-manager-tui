#!/bin/sh
set -e

# Create service user/group and runtime dirs
if ! getent group spms >/dev/null 2>&1; then
  addgroup --system spms >/dev/null 2>&1 || true
fi
if ! getent passwd spms >/dev/null 2>&1; then
  adduser --system --ingroup spms --home /opt/spms --no-create-home --shell /usr/sbin/nologin spms >/dev/null 2>&1 || true
fi

mkdir -p /var/lib/spms /etc/spms
chown -R spms:spms /var/lib/spms || true

# Create default env file if missing (admin must set a strong secret)
if [ ! -f /etc/spms/spms.env ]; then
  cat > /etc/spms/spms.env <<'EOF'
# SPMS environment (edit before starting service)
PM_DATA_DIR=/var/lib/spms
PM_WEB_SECRET_KEY=change-me-to-a-long-random-secret
PM_WEB_COOKIE_SECURE=1
HOST=127.0.0.1
PORT=8000
PYTHONPATH=/opt/spms/src:/opt/spms
EOF
  chmod 0640 /etc/spms/spms.env || true
  chown root:spms /etc/spms/spms.env || true
fi

echo "SPMS installed to /opt/spms"
echo "Next steps:"
echo "  1) python3 -m venv /opt/spms/.venv && /opt/spms/.venv/bin/pip install -r /opt/spms/requirements.txt"
echo "  2) Edit /etc/spms/spms.env (set strong PM_WEB_SECRET_KEY, bind/TLS settings)"
echo "  3) systemctl daemon-reload && systemctl enable --now spms-web"
echo "SQLite safety: service must run with --workers 1"

exit 0