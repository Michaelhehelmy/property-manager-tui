# Example environment for Docker Compose / local web deployment
# Copy to .env and edit values as needed.

# REQUIRED for non-local/shared access (generate: openssl rand -hex 32)
PM_WEB_SECRET_KEY=change-me-to-a-long-random-secret

# Set to 1 when served behind HTTPS reverse proxy (Secure cookies)
PM_WEB_COOKIE_SECURE=0

# Persistent runtime data directory (DB, exports, invoices)
PM_DATA_DIR=/data

# Optional runtime overrides
TZ=UTC
HOST=0.0.0.0
PORT=8000
