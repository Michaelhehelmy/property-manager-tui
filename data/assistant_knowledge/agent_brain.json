    {
      "id": "tool_builder",
      "name": "Tool Builder",
      "enabled": false,
      "type": "workflow_skill",
      "description": "Guarded workflow for creating/extending assistant tools via clear validated steps.",
      "entry_state": "spec_collect",
      "states": {
        "spec_collect": {
          "required": [
            "id",
            "purpose",
            "args_schema",
            "read_only"
          ],
          "next": "reuse_check",
          "gate": "required_fields_present"
        },
        "reuse_check": {
          "next": "type_decide",
          "gate": "no_duplicate_or_confirm_replace"
        },
        "type_decide": {
          "next": "plan",
          "gate": "type_allowed"
        },
        "plan": {
          "next": "generate",
          "gate": "plan_has_files_tests_risks"
        },
        "generate": {
          "next": "register",
          "gate": "allowed_paths_and_safe_code"
        },
        "register": {
          "next": "validate",
          "gate": "handler_resolves"
        },
        "validate": {
          "next_on_pass": "approve",
          "next_on_fail": "generate",
          "gate": "checks_pass"
        },
        "approve": {
          "next_on_approved": "enable",
          "next_on_rejected": "spec_collect",
          "gate": "owner_approved"
        },
        "enable": {
          "next": "learn",
          "gate": "manifest_enabled_and_loaded"
        },
        "learn": {
          "terminal": true
        }
      },
      "tags": [
        "builder",
        "workflow",
        "dev"
      ]
    }
